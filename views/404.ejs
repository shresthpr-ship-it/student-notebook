<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found - Student Notebook</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="desk-nav">
    <a href="/" class="desk-logo">
      <span>📓</span>
      <div>Student Notebook</div>
    </a>
  </nav>

  <div class="desk-container" style="max-width: 600px; margin-top: 4rem; text-align: center;">
    <div class="note-card paper-lined" style="padding: 3rem 2rem;">
      <div style="font-size: 3rem; margin-bottom: 0.5rem;">📄✂️</div>
      <h1 class="font-handwriting ink-red" style="font-size: 2.5rem; margin-bottom: 0.5rem;">Page Not Found</h1>
      <p style="color: #64748b; margin-bottom: 2rem;">
        This page seems to have been torn out or moved from the notebook.
      </p>
      <a href="/" class="btn-notebook-save" style="text-decoration: none; display: inline-flex;">
        &larr; Return to Desk
      </a>
    </div>
  </div>
</body>
</html>
