<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pomodoro Focus Room &amp; Soundscapes</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Desk Navigation -->
  <nav class="desk-nav">
    <a href="/" class="desk-logo">
      <span>🍅</span>
      <div>
        <div>Pomodoro Study Room</div>
        <div style="font-size: 0.75rem; color: #64748b;">Focus Timer &amp; Ambient Music</div>
      </div>
    </a>

    <div class="nav-actions">
      <!-- Pomodoro Streak -->
      <div class="streak-pill" style="background: #fef2f2; border-color: #fecaca; color: #b91c1c;">
        <span class="streak-flame">🍅</span>
        <span id="navPomodoroStreak"><%= student.pomodoro?.currentStreak || 0 %> Day Focus Streak</span>
      </div>

      <!-- To-Do Streak -->
      <a href="/streak" class="streak-pill" title="View Daily Streak Analytics">
        <span class="streak-flame">🔥</span>
        <span><%= student.currentStreak || 0 %> Day To-Do</span>
      </a>

      <div class="student-tag">
        <span>👨‍🎓</span>
        <span><%= student.displayName %></span>
      </div>

      <a href="/" class="btn-logout" style="color: #4f46e5; background: #eef2ff;">
        &larr; Back to Desk
      </a>
      <a href="/logout" class="btn-logout">Sign Out</a>
    </div>
  </nav>

  <div class="desk-container">
    <!-- Main Pomodoro Notebook Spread -->
    <div class="notebook-binder">
      <!-- Spiral Header -->
      <div class="spiral-header">
        <% for(let i = 0; i < 18; i++) { %>
          <div class="spiral-ring"></div>
        <% } %>
      </div>

      <div class="notebook-page paper-lined" style="padding: 2.5rem;">
        <div style="display: grid; grid-template-columns: 1.2fr 1fr; gap: 2.5rem; align-items: start;" class="pomodoro-grid-layout">
          
          <!-- LEFT: Timer Section -->
          <div style="background: #ffffff; border-radius: 16px; padding: 2rem; border: 1.5px solid #cbd5e1; box-shadow: var(--shadow-card); text-align: center;">
            
            <!-- Mode Switcher -->
            <div style="display: inline-flex; background: #f1f5f9; padding: 0.35rem; border-radius: 9999px; gap: 0.35rem; margin-bottom: 2rem;">
              <button type="button" class="pomo-mode-btn active" data-mode="focus" data-time="25">
                🍅 Focus (25m)
              </button>
              <button type="button" class="pomo-mode-btn" data-mode="shortBreak" data-time="5">
                ☕ Short Break (5m)
              </button>
              <button type="button" class="pomo-mode-btn" data-mode="longBreak" data-time="15">
                🛋️ Long Break (15m)
              </button>
            </div>

            <!-- Big Timer Display -->
            <div style="position: relative; width: 240px; height: 240px; margin: 0 auto 1.5rem auto; display: flex; align-items: center; justify-content: center;">
              <!-- Circular Progress SVG -->
              <svg width="240" height="240" style="transform: rotate(-90deg); position: absolute; top:0; left:0;">
                <circle cx="120" cy="120" r="105" stroke="#f1f5f9" stroke-width="12" fill="none"></circle>
                <circle id="timerProgressCircle" cx="120" cy="120" r="105" stroke="#ef4444" stroke-width="12" fill="none" stroke-dasharray="660" stroke-dashoffset="0" stroke-linecap="round" style="transition: stroke-dashoffset 1s linear, stroke 0.3s;"></circle>
              </svg>

              <!-- Digits -->
              <div style="position: relative; z-index: 10;">
                <div id="timerDigits" style="font-size: 3.5rem; font-weight: 900; font-family: 'Space Mono', monospace; color: #1e293b; letter-spacing: -2px;">
                  25:00
                </div>
                <div id="timerStatusLabel" style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: #ef4444; margin-top: -5px;">
                  DEEP FOCUS
                </div>
              </div>
            </div>

            <!-- Timer Action Buttons -->
            <div style="display: flex; justify-content: center; gap: 1rem; margin-bottom: 1.5rem;">
              <button type="button" id="startPauseBtn" class="btn-notebook-save" style="padding: 0.85rem 2.2rem; font-size: 1.1rem; border-radius: 9999px;">
                ▶️ Start Focus
              </button>
              <button type="button" id="resetBtn" class="btn-logout" style="background: #f1f5f9; padding: 0.85rem 1.5rem; border-radius: 9999px; font-weight: 700;">
                🔄 Reset
              </button>
            </div>

            <!-- Time Quick Adjusters -->
            <div style="display: flex; justify-content: center; gap: 0.5rem;">
              <button type="button" class="btn-logout" id="minusFiveBtn" style="font-size: 0.75rem; background: #f8fafc; border: 1px solid #cbd5e1;">- 5 Min</button>
              <button type="button" class="btn-logout" id="plusFiveBtn" style="font-size: 0.75rem; background: #f8fafc; border: 1px solid #cbd5e1;">+ 5 Min</button>
            </div>
          </div>

          <!-- RIGHT: Background Music & Ambient Soundscapes -->
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            
            <!-- Soundscapes Player Box -->
            <div style="background: #ffffff; border-radius: 16px; padding: 1.75rem; border: 1.5px solid #cbd5e1; box-shadow: var(--shadow-card);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <h3 style="font-size: 1.15rem; font-weight: 800; color: #1e293b; display: flex; align-items: center; gap: 0.5rem;">
                  <span>🎧</span> Focus Soundscapes
                </h3>
                <div id="soundWaveAnim" style="display: none; align-items: flex-end; gap: 3px; height: 16px;">
                  <div style="width: 3px; height: 100%; background: #4f46e5; animation: wave 0.8s infinite ease-in-out alternate;"></div>
                  <div style="width: 3px; height: 60%; background: #4f46e5; animation: wave 1.1s infinite ease-in-out alternate;"></div>
                  <div style="width: 3px; height: 80%; background: #4f46e5; animation: wave 0.6s infinite ease-in-out alternate;"></div>
                  <div style="width: 3px; height: 40%; background: #4f46e5; animation: wave 0.9s infinite ease-in-out alternate;"></div>
                </div>
              </div>

              <!-- Sound Presets Grid -->
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem;">
                <button type="button" class="ambient-choice-btn active" data-sound="rain">
                  <span>🌧️</span>
                  <div>
                    <div style="font-weight: 700; font-size: 0.85rem;">Gentle Rain</div>
                    <div style="font-size: 0.7rem; opacity: 0.75;">Soft rainfall on window</div>
                  </div>
                </button>

                <button type="button" class="ambient-choice-btn" data-sound="waves">
                  <span>🌊</span>
                  <div>
                    <div style="font-weight: 700; font-size: 0.85rem;">Ocean Tide</div>
                    <div style="font-size: 0.7rem; opacity: 0.75;">Rhythmic calm surf</div>
                  </div>
                </button>

                <button type="button" class="ambient-choice-btn" data-sound="brown">
                  <span>🕯️</span>
                  <div>
                    <div style="font-weight: 700; font-size: 0.85rem;">Deep Brown Noise</div>
                    <div style="font-size: 0.7rem; opacity: 0.75;">Mask background chatter</div>
                  </div>
                </button>

                <button type="button" class="ambient-choice-btn" data-sound="lofi">
                  <span>🎵</span>
                  <div>
                    <div style="font-weight: 700; font-size: 0.85rem;">Lo-Fi Synth Chords</div>
                    <div style="font-size: 0.7rem; opacity: 0.75;">Warm study frequencies</div>
                  </div>
                </button>

                <button type="button" class="ambient-choice-btn" data-sound="coffee">
                  <span>☕</span>
                  <div>
                    <div style="font-weight: 700; font-size: 0.85rem;">Cozy Café</div>
                    <div style="font-size: 0.7rem; opacity: 0.75;">Warm study ambience</div>
                  </div>
                </button>

                <button type="button" class="ambient-choice-btn" data-sound="forest">
                  <span>🌲</span>
                  <div>
                    <div style="font-weight: 700; font-size: 0.85rem;">Deep Forest</div>
                    <div style="font-size: 0.7rem; opacity: 0.75;">Breeze and birdsong</div>
                  </div>
                </button>
              </div>

              <!-- Audio Player Controls -->
              <div style="background: #f8fafc; border-radius: 10px; padding: 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; border: 1px solid #e2e8f0;">
                <button type="button" id="toggleAmbientBtn" class="btn-notebook-save" style="padding: 0.5rem 1.25rem; font-size: 0.9rem; background: #4f46e5;">
                  ▶️ Play Soundscape
                </button>

                <div style="display: flex; align-items: center; gap: 0.6rem; flex-grow: 1; max-width: 170px;">
                  <span style="font-size: 0.85rem;">🔊</span>
                  <input type="range" id="volumeSlider" min="0" max="1" step="0.05" value="0.5" style="width: 100%; cursor: pointer;">
                </div>
              </div>
            </div>

            <!-- Pomodoro Streak Stats Card -->
            <div style="background: #ffffff; border-radius: 16px; padding: 1.5rem; border: 1.5px solid #cbd5e1; box-shadow: var(--shadow-card);">
              <h4 style="font-size: 0.95rem; font-weight: 800; color: #1e293b; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.4rem;">
                <span>🔥</span> Focus Streak &amp; Habit Record
              </h4>

              <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.75rem; text-align: center;">
                <div style="background: #fef2f2; padding: 0.75rem; border-radius: 8px; border: 1px solid #fecaca;">
                  <div style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700; color: #991b1b;">Streak</div>
                  <div id="statPomoStreak" style="font-size: 1.4rem; font-weight: 900; color: #dc2626;">
                    <%= student.pomodoro?.currentStreak || 0 %>d
                  </div>
                </div>

                <div style="background: #f0fdf4; padding: 0.75rem; border-radius: 8px; border: 1px solid #bbf7d0;">
                  <div style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700; color: #166534;">Sessions</div>
                  <div id="statPomoSessions" style="font-size: 1.4rem; font-weight: 900; color: #16a34a;">
                    <%= student.pomodoro?.totalSessions || 0 %>
                  </div>
                </div>

                <div style="background: #eff6ff; padding: 0.75rem; border-radius: 8px; border: 1px solid #bfdbfe;">
                  <div style="font-size: 0.7rem; text-transform: uppercase; font-weight: 700; color: #1e40af;">Total Focus</div>
                  <div id="statPomoMinutes" style="font-size: 1.4rem; font-weight: 900; color: #2563eb;">
                    <%= student.pomodoro?.totalMinutes || 0 %>m
                  </div>
                </div>
              </div>

              <!-- Certificate Callout -->
              <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px dashed #cbd5e1; display: flex; align-items: center; justify-content: space-between;">
                <div style="font-size: 0.8rem; color: #64748b;">
                  <div>Weekly Consistency Certificate</div>
                  <div style="font-weight: 600; color: #1e293b;">Sent to: <%= student.email %></div>
                </div>
                <button type="button" id="triggerCertBtn" class="btn-logout" style="background: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; font-weight: 700;">
                  🏆 Email Certificate
                </button>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .pomo-mode-btn {
      background: transparent;
      border: none;
      padding: 0.5rem 1.15rem;
      border-radius: 9999px;
      font-size: 0.85rem;
      font-weight: 700;
      color: #64748b;
      cursor: pointer;
      transition: all 0.2s;
    }
    .pomo-mode-btn.active {
      background: #ffffff;
      color: #0f172a;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }
    .ambient-choice-btn {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.75rem;
      border-radius: 10px;
      border: 1.5px solid #e2e8f0;
      background: #ffffff;
      cursor: pointer;
      text-align: left;
      transition: all 0.15s;
    }
    .ambient-choice-btn:hover {
      border-color: #6366f1;
      background: #f8fafc;
    }
    .ambient-choice-btn.active {
      border-color: #4f46e5;
      background: #eef2ff;
      box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.2);
    }
    @keyframes wave {
      0% { height: 4px; }
      100% { height: 16px; }
    }
    @media (max-width: 820px) {
      .pomodoro-grid-layout {
        grid-template-columns: 1fr !important;
      }
    }
  </style>

  <!-- Pomodoro & Synthesized Sound Engine Script -->
  <script src="/js/pomodoro.js"></script>
</body>
</html>
